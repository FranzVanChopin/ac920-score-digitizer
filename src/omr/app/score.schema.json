{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed score input",
  "type": "object",
  "required": ["title", "parts"],
  "properties": {
    "title": {"type": "string"},
    "composer": {"type": "string"},
    "tempo_bpm": {"type": "number", "exclusiveMinimum": 0},
    "time_signature": {
      "type": "object", "required": ["beats", "beat_type"],
      "properties": {"beats": {"type": "integer", "minimum": 1}, "beat_type": {"type": "integer", "minimum": 1}}
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "events"],
        "properties": {
          "name": {"type": "string"},
          "clef": {"type": "string", "enum": ["treble", "bass"]},
          "events": {
            "type": "array",
            "items": {
              "type": "object", "required": ["start_beats", "duration_beats"],
              "properties": {
                "start_beats": {"type": "number", "minimum": 0},
                "duration_beats": {"type": "number", "exclusiveMinimum": 0},
                "midi": {"type": ["integer", "null"], "minimum": 0, "maximum": 127}
              }
            }
          }
        }
      }
    }
  }
}
