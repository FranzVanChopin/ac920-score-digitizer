# AC920 carrier pinout, checked against the supplied camera example and schematic.
# MIPI D-PHY I/O and timing are generated by CSI IP configured for bank65:
# CLK P/N W8/Y8; D0 P/N U9/V9; D1 P/N U8/V8. Bank65 must be 1.2 V.
# The HQ Camera receives 3.3 V; camera control bank46 must be 3.3 V.
set_property PACKAGE_PIN F13 [get_ports {camera_enable[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_enable[0]}]
set_property PACKAGE_PIN G14 [get_ports camera_i2c_scl_io]
set_property PACKAGE_PIN G15 [get_ports camera_i2c_sda_io]
set_property IOSTANDARD LVCMOS33 [get_ports {camera_i2c_scl_io camera_i2c_sda_io}]

# Board 100 MHz differential oscillator (negative companion fixed by device).
set_property PACKAGE_PIN AE5 [get_ports board_clk_clk_p]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports {board_clk_clk_p board_clk_clk_n}]

set_property PACKAGE_PIN AC14 [get_ports hdmi_clk_p]
set_property PACKAGE_PIN AC13 [get_ports hdmi_clk_n]
set_property PACKAGE_PIN Y14 [get_ports {hdmi_data_p[0]}]
set_property PACKAGE_PIN Y13 [get_ports {hdmi_data_n[0]}]
set_property PACKAGE_PIN AA13 [get_ports {hdmi_data_p[1]}]
set_property PACKAGE_PIN AB13 [get_ports {hdmi_data_n[1]}]
set_property PACKAGE_PIN AD15 [get_ports {hdmi_data_p[2]}]
set_property PACKAGE_PIN AD14 [get_ports {hdmi_data_n[2]}]
set_property IOSTANDARD DIFF_HSTL_I_18 [get_ports {hdmi_clk_p hdmi_clk_n hdmi_data_p[*] hdmi_data_n[*]}]
set_property SLEW FAST [get_ports {hdmi_clk_p hdmi_clk_n hdmi_data_p[*] hdmi_data_n[*]}]
# MIO44 push-button, SD1 and UART1 are PS pins, configured by the PS preset.
# S3/AH14 intentionally unused. S1 short/long press is handled on PS MIO44.
